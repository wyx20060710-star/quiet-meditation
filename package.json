{
  "name": "quiet-meditation",
  "private": true,
  "version": "2.0.0",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
    "build": "tsc --noEmit && vite build --configLoader runner",
